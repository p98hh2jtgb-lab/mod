            ["$slingshotChargeSec", "range", "s", "Functionality", 3, 1, 60, "Charge Time", "Duration in seconds to apply the pull-back before launching"],
            ["$horizontalDirectionDegree", "range", "°", "Functionality", 0, -180, 180, "Horizontal Direction", "Direction of the boost: 0 for forward, 90 for right, -90 for left, 180 for backward"],
            ["$verticalAngleDegree", "range", "°", "Functionality", 0, 0, 90, "Vertical Angle", "Vertical angle of the boost: 0 for horizontal, 90 for just vertical angle"]
        ],
