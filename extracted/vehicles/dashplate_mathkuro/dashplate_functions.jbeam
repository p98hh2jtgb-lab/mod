        ],
        "controller": [
            ["fileName"],
            ["executeFunction", {"dashplateFunctionName":"slingshot", "dashplateSpeedKMH":"$slingshotSpeedKMH", "dashplateSlingshotChargeSec":"$slingshotChargeSec", "dashplateHorizontalDirectionDegree":"$horizontalDirectionDegree", "dashplateVerticalAngleDegree":"$verticalAngleDegree", "dashplateUseDashplateDirection":true}]
        ]
    },
