<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_effects>
    <effect id="dashplate_flat_megaramp_walls-effect">
      <profile_COMMON><technique sid="common"><lambert><diffuse><color>1 1 1 1</color></diffuse></lambert></technique></profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="dashplate_flat_megaramp_walls-material" name="dashplate_flat_jump_flow">
      <instance_effect url="#dashplate_flat_megaramp_walls-effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="dashplate_flat_megaramp_walls-mesh" name="dashplate_flat_megaramp_walls">
      <mesh>
        <source id="dashplate_flat_megaramp_walls-positions">
          <float_array id="dashplate_flat_megaramp_walls-positions-array" count="24">-5 -12.5 9.01666 -5 -12.5 6.5 -5 12.5 -0.35 -5 12.5 0.0166566 5 -12.5 9.01666 5 -12.5 6.5 5 12.5 -0.35 5 12.5 0.0166566</float_array>
          <technique_common><accessor source="#dashplate_flat_megaramp_walls-positions-array" count="8" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="dashplate_flat_megaramp_walls-normals">
          <float_array id="dashplate_flat_megaramp_walls-normals-array" count="3">0 0 1</float_array>
          <technique_common><accessor source="#dashplate_flat_megaramp_walls-normals-array" count="1" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="dashplate_flat_megaramp_walls-map">
          <float_array id="dashplate_flat_megaramp_walls-map-array" count="16">0 3 1 3 1 0 0 0 0 3 1 3 1 0 0 0</float_array>
          <technique_common><accessor source="#dashplate_flat_megaramp_walls-map-array" count="8" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common>
        </source>
        <vertices id="dashplate_flat_megaramp_walls-vertices"><input semantic="POSITION" source="#dashplate_flat_megaramp_walls-positions"/></vertices>
        <triangles material="dashplate_flat_megaramp_walls-material" count="4">
          <input semantic="VERTEX" source="#dashplate_flat_megaramp_walls-vertices" offset="0"/>
          <input semantic="NORMAL" source="#dashplate_flat_megaramp_walls-normals" offset="1"/>
          <input semantic="TEXCOORD" source="#dashplate_flat_megaramp_walls-map" offset="2" set="0"/>
          <p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3 4 0 4 5 0 5 6 0 6 4 0 4 6 0 6 7 0 7</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="dashplate_flat_megaramp_walls" name="dashplate_flat_megaramp_walls" type="NODE">
        <instance_geometry url="#dashplate_flat_megaramp_walls-mesh">
          <bind_material><technique_common><instance_material symbol="dashplate_flat_megaramp_walls-material" target="#dashplate_flat_megaramp_walls-material"/></technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
