<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_effects>
    <effect id="dashplate_flat_strike_design-effect">
      <profile_COMMON><technique sid="common"><lambert><diffuse><color>1 1 1 1</color></diffuse></lambert></technique></profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="dashplate_flat_strike_design-material" name="dashplate_flat_strike_design">
      <instance_effect url="#dashplate_flat_strike_design-effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="dashplate_flat_strike_design-mesh" name="dashplate_flat_strike_design">
      <mesh>
        <source id="dashplate_flat_strike_design-positions">
          <float_array id="dashplate_flat_strike_design-positions-array" count="12">-1.25 -2.25 0.025 1.25 -2.25 0.025 1.25 2.25 0.025 -1.25 2.25 0.025</float_array>
          <technique_common><accessor source="#dashplate_flat_strike_design-positions-array" count="4" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="dashplate_flat_strike_design-normals">
          <float_array id="dashplate_flat_strike_design-normals-array" count="3">0 0 1</float_array>
          <technique_common><accessor source="#dashplate_flat_strike_design-normals-array" count="1" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="dashplate_flat_strike_design-map">
          <float_array id="dashplate_flat_strike_design-map-array" count="8">0 1 1 1 1 0 0 0</float_array>
          <technique_common><accessor source="#dashplate_flat_strike_design-map-array" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common>
        </source>
        <vertices id="dashplate_flat_strike_design-vertices"><input semantic="POSITION" source="#dashplate_flat_strike_design-positions"/></vertices>
        <triangles material="dashplate_flat_strike_design-material" count="2">
          <input semantic="VERTEX" source="#dashplate_flat_strike_design-vertices" offset="0"/>
          <input semantic="NORMAL" source="#dashplate_flat_strike_design-normals" offset="1"/>
          <input semantic="TEXCOORD" source="#dashplate_flat_strike_design-map" offset="2" set="0"/>
          <p>0 1 2 0 2 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="dashplate_flat_strike_design" name="dashplate_flat_strike_design" type="NODE">
        <instance_geometry url="#dashplate_flat_strike_design-mesh">
          <bind_material><technique_common><instance_material symbol="dashplate_flat_strike_design-material" target="#dashplate_flat_strike_design-material"/></technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
