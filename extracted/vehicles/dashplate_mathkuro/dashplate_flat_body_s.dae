<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_effects>
    <effect id="dashplate_flat_body_s-effect">
      <profile_COMMON><technique sid="common"><lambert><diffuse><color>1 1 1 1</color></diffuse></lambert></technique></profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="dashplate_flat_body_s-material" name="dashplate_flat_body_main">
      <instance_effect url="#dashplate_flat_body_s-effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="dashplate_flat_body_s-mesh" name="dashplate_flat_body_s">
      <mesh>
        <source id="dashplate_flat_body_s-positions">
          <float_array id="dashplate_flat_body_s-positions-array" count="60">-1 -1.5 0.0166566 -0.333333 -1.5 0.0166566 0.333333 -1.5 0.0166566 1 -1.5 0.0166566 -1 -0.75 0.0166566 -0.333333 -0.75 0.0166566 0.333333 -0.75 0.0166566 1 -0.75 0.0166566 -1 0 0.0166566 -0.333333 0 0.0166566 0.333333 0 0.0166566 1 0 0.0166566 -1 0.75 0.0166566 -0.333333 0.75 0.0166566 0.333333 0.75 0.0166566 1 0.75 0.0166566 -1 1.5 0.0166566 -0.333333 1.5 0.0166566 0.333333 1.5 0.0166566 1 1.5 0.0166566</float_array>
          <technique_common><accessor source="#dashplate_flat_body_s-positions-array" count="20" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="dashplate_flat_body_s-normals">
          <float_array id="dashplate_flat_body_s-normals-array" count="3">0 0 1</float_array>
          <technique_common><accessor source="#dashplate_flat_body_s-normals-array" count="1" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="dashplate_flat_body_s-map">
          <float_array id="dashplate_flat_body_s-map-array" count="40">0 1 0.3333333 1 0.6666667 1 1 1 0 0.75 0.3333333 0.75 0.6666667 0.75 1 0.75 0 0.5 0.3333333 0.5 0.6666667 0.5 1 0.5 0 0.25 0.3333333 0.25 0.6666667 0.25 1 0.25 0 0 0.3333333 0 0.6666667 0 1 0</float_array>
          <technique_common><accessor source="#dashplate_flat_body_s-map-array" count="20" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common>
        </source>
        <vertices id="dashplate_flat_body_s-vertices"><input semantic="POSITION" source="#dashplate_flat_body_s-positions"/></vertices>
        <triangles material="dashplate_flat_body_s-material" count="24">
          <input semantic="VERTEX" source="#dashplate_flat_body_s-vertices" offset="0"/>
          <input semantic="NORMAL" source="#dashplate_flat_body_s-normals" offset="1"/>
          <input semantic="TEXCOORD" source="#dashplate_flat_body_s-map" offset="2" set="0"/>
          <p>0 1 5 0 5 4 1 2 6 1 6 5 2 3 7 2 7 6 4 5 9 4 9 8 5 6 10 5 10 9 6 7 11 6 11 10 8 9 13 8 13 12 9 10 14 9 14 13 10 11 15 10 15 14 12 13 17 12 17 16 13 14 18 13 18 17 14 15 19 14 19 18</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="dashplate_flat_body_s" name="dashplate_flat_body_s" type="NODE">
        <instance_geometry url="#dashplate_flat_body_s-mesh">
          <bind_material><technique_common><instance_material symbol="dashplate_flat_body_s-material" target="#dashplate_flat_body_s-material"/></technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
