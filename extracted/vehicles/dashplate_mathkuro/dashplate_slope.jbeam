{
    "dashplate_slope_body": {
        "information": {
            "authors": "mathkuro (based on official Kick Plate)",
            "isAuxiliary": true,
            "name": "Dash Plate Body(Slope)"
        },
        "slotType": "dashplate_body",
        "slots": [
            ["type", "default", "description"]
        ],
        "refNodes":[
            ["ref:", "back:", "left:", "up:"],
            ["ref", "refback", "refleft", "refup"]
        ],
        "cameraExternal":{
            "distance":10,
            "distanceMin":4,
            "offset":{"x":0, "y":1.5, "z":1},
            "fov":65
        },
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"]
        ],
        "controller": [
            ["fileName"],
            ["dashplate"]
        ],
        "nodes": [
             ["id", "posX", "posY", "posZ"],
             {"frictionCoef":10.0},
             {"nodeMaterial":"|NM_METAL"},
    
             //up refnode
             {"collision":false},
             ["ref", 0.0, 0.0, 0.0],
             ["refback", 0.0, 1.0, 0.0],
             ["refleft", 1.0, 0.0, 0.0],
             ["refup", 0.0, 0.0, 1.0],
    
             //dashplate
             {"collision":true},
             {"selfCollision":false},
             {"group":"dp"},
             {"nodeWeight":500},
             ["dp_0",-3.0,-1.0, 0.01],
             ["dp_2",-3.0, 2.0, 0.01],
             ["dp_4", 3.0,-1.0, 0.01],
             ["dp_6", 3.0, 2.0, 0.01],
             {"nodeWeight":1000},
             ["dp_1",-3.0,-2.0, -0.1],
             ["dp_3",-3.0, 3.0, -0.1],
             ["dp_5", 3.0,-2.0, -0.1],
             ["dp_7", 3.0, 3.0, -0.1],
             ["dp_0_l", -3, -1.0, -0.1],
             ["dp_2_l", -3, 2.0, -0.1],
             ["dp_4_l", 3, -1.0, -0.1],
             ["dp_6_l", 3, 2.0, -0.1]
            ],
        "beams": [
              ["id1:", "id2:"],
              {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
              {"beamSpring":50000000,"beamDamp":100000},
              {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
              // dashplate
              ["dp_0","dp_6"],
              ["dp_0","dp_4"],
              ["dp_2","dp_6"],
              ["dp_0","dp_2"],
              ["dp_4","dp_6"],
              ["dp_1","dp_0"],
              ["dp_3","dp_1"],
              ["dp_2","dp_3"],
              ["dp_7","dp_3"],
              ["dp_6","dp_7"],
              ["dp_5","dp_7"],
              ["dp_4","dp_5"],
              ["dp_1","dp_5"],
              ["dp_4","dp_2"],
              ["dp_2","dp_1"],
              ["dp_3","dp_0"],
              ["dp_6","dp_3"],
              ["dp_7","dp_2"],
              ["dp_6","dp_5"],
              ["dp_7","dp_4"],
              ["dp_7","dp_1"],
              ["dp_5","dp_3"],
              ["dp_4","dp_1"],
              ["dp_5","dp_0"],
              ["dp_4","dp_3"],
              ["dp_6","dp_1"],
              ["dp_7","dp_0"],
              ["dp_5","dp_2"],

              ["dp_0_l", "dp_0"],
              ["dp_0_l", "dp_1"],
              ["dp_0_l", "dp_2_l"],
              ["dp_0_l", "dp_4_l"],
              ["dp_2_l", "dp_2"],
              ["dp_2_l", "dp_3"],
              ["dp_2_l", "dp_6_l"],
              ["dp_4_l", "dp_4"],
              ["dp_4_l", "dp_5"],
              ["dp_4_l", "dp_6_l"],
              ["dp_6_l", "dp_6"],
              ["dp_6_l", "dp_7"],

              //refnode
              {"beamSpring":50001000,"beamDamp":5000},
              ["ref", "dp_7"],
              ["ref", "dp_5"],
              ["ref", "dp_3"],
              ["ref", "dp_1"],
              ["refup", "dp_7"],
              ["refup", "dp_5"],
              ["refup", "dp_3"],
              ["refup", "dp_1"],
              ["refback", "dp_7"],
              ["refback", "dp_5"],
              ["refback", "dp_3"],
              ["refback", "dp_1"],
              ["refleft", "dp_7"],
              ["refleft", "dp_5"],
              ["refleft", "dp_3"],
              ["refleft", "dp_1"]
        ],
        "triangles": [
            ["id1:","id2:","id3:"],
            {"groundModel":"dashplate"},
            //dashplate
            ["dp_0","dp_4","dp_6"],
            ["dp_6","dp_2","dp_0"],

            ["dp_1","dp_3","dp_5"],
            ["dp_3","dp_5","dp_7"],

            ["dp_0", "dp_1", "dp_5"],
            ["dp_5", "dp_4", "dp_0"],

            ["dp_6", "dp_7", "dp_3"],
            ["dp_3", "dp_2", "dp_6"],

            ["dp_2", "dp_3", "dp_2_l"],
            ["dp_1", "dp_0", "dp_0_l"],

            ["dp_4", "dp_5", "dp_4_l"],
            ["dp_7", "dp_6", "dp_6_l"],

            ["dp_0", "dp_0_l", "dp_2_l"],
